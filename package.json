{
  "name": "@nath-vikky/dsh-codekin",
  "description": "Codekin creature collection and match-three RPG for DeepSeek Harness Web",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node --run clean && pnpm --filter @nath-vikky/codekin-engine build && tsc -p tsconfig.json && tsdown",
    "clean": "node --eval \"import('node:fs/promises').then(async ({rm}) => { await rm('lib', { recursive: true, force: true }); await rm('packages/engine/dist', { recursive: true, force: true }) })\"",
    "test": "vitest run",
    "typecheck": "pnpm --filter @nath-vikky/codekin-engine typecheck && tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.vitest.json --noEmit --pretty false",
    "check": "node --run typecheck && node --run test && node --run build",
    "prepack": "node --run check"
  },
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./engine": {
      "types": "./lib/types/packages/engine/src/index.d.ts",
      "default": "./lib/engine.js"
    },
    "./content": {
      "types": "./lib/types/packages/content-sdk/src/index.d.ts",
      "default": "./lib/content.js"
    },
    "./content/core": {
      "types": "./lib/types/content-packs/core/src/index.d.ts",
      "default": "./lib/content-core.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.1 <0.1.2",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "link:../deepseek-harness-alpha/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness-alpha/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness-alpha/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness-alpha/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "link:../deepseek-harness-alpha/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness-alpha/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:../deepseek-harness-alpha/packages/host/webserver",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness-alpha/packages/core/session",
    "@types/node": "22.20.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nath-Vikky/dsh-codekin.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codekin",
    "creature-collector",
    "match-3",
    "game"
  ],
  "license": "MIT",
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "assets/creatures/sprite-gallery-v1.png",
    "assets/creatures/sprites",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "ajv": "8.20.0"
  }
}
